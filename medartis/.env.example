# PostgreSQL / Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Google Sheets and Drive service account
GOOGLE_SPREADSHEET_ID="your-google-spreadsheet-id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_PARENT_FOLDER_ID="google-drive-folder-id"

# Web Push (generate once with: npx web-push generate-vapid-keys)
# VAPID_SUBJECT must be a mailto: address or an HTTPS URL.
VAPID_SUBJECT="mailto:operations@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="public-vapid-key"
VAPID_PRIVATE_KEY="private-vapid-key"

# Optional email notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="Medartis Booking <no-reply@example.com>"
WAREHOUSE_EMAIL="warehouse@example.com"
SALES_COORDINATOR_EMAIL="sales-coordinator@example.com"
